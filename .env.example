# Default backend environment ("prod" | "staging" | "local")
NEXT_PUBLIC_DEFAULT_ENV=staging

# Backend URLs used by the Next.js server-side proxy (/api/proxy/*)
# Production (fiszki-server main branch -> default port 8080)
FISZKI_PROD_API_URL=http://localhost:8080

# Staging (fiszki-server dev branch -> default port 8081)
FISZKI_STAGING_API_URL=http://localhost:8081

# Optional custom override URL
NEXT_PUBLIC_API_BASE_URL=
